{
  "name": "codymatch-backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "app.js",
  "imports": {
    "#root/*": "./*"
  },
  "scripts": {
    "start": "node app.js",
    "debug": "node --inspect=0.0.0.0:9230 app.js",
    "debug-brk": "node --inspect-brk=0.0.0.0:9230 app.js",
    "migrate": "node migrator.js db:migrate",
    "migrate-undo": "node migrator.js db:migrate:undo",
    "migrate-undo-all": "node migrator.js db:migrate:undo:all",
    "migration:new": "node scripts/create-migration.js",
    "lint": "biome check . && find . \\( -path './node_modules' -o -path './.idea' \\) -prune -o -type f -name '*.md' -print0 | xargs -0 -r markdownlint-cli2 --fix",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "lodash": "^4.17.23",
    "morgan": "^1.10.1",
    "pg": "^8.18.0",
    "pg-boss": "^12.13.0",
    "redis": "^5.11.0",
    "rotating-file-stream": "^3.2.9",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@vitest/coverage-v8": "^4.0.18",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.21.0",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "**/*.js": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "**/*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "overrides": {
    "ajv": "^8.18.0"
  }
}
