{
  "name": "frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "imports": {
    "#constants/*": "./assets/constants/*",
    "#components/*": "./assets/components/*",
    "#img/*": "./assets/img/*",
    "#js/*": "./assets/js/*",
    "#modules/*": "./assets/modules/*",
    "#css/*": "./assets/css/*",
    "#config/*": "./config/*"
  },
  "scripts": {
    "start": "vite preview --host 0.0.0.0 --port ${PROJECT_PORT:-3002}",
    "debug": "vite --host 0.0.0.0 --port ${PROJECT_PORT:-3002}",
    "build": "vite build",
    "lint": "biome check . && stylelint '**/*.css' --fix --ignore-path .lintignore && find . \\( -path './node_modules' -o -path './dist' -o -path './.idea' \\) -prune -o -type f -name '*.md' -print0 | xargs -0 -r markdownlint-cli2 --fix",
    "lint:scss": "stylelint '**/*.scss' --fix",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@reduxjs/toolkit": "^2.11.2",
    "ajv": "^8.18.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.21.0",
    "postcss": "^8.5.6",
    "stylelint": "^17.3.0",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "**/*.{js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "**/*.css": [
      "stylelint --fix",
      "biome format --write --no-errors-on-unmatched"
    ],
    "**/*.md": [
      "markdownlint-cli2 --fix"
    ]
  }
}
